{
  "version": 2,
  "builds": [
    { "src": "api/**/*.js", "use": "@vercel/node" }
  ],
  "routes": [
    {
      "src": "/manifest.json",
      "dest": "/api/manifest.js"
    },
    {
      "src": "/stream/([^/]+)/([^/]+)\\.json",
      "dest": "/api/stream.js?type=$1&id=$2"
    },
    {
      "src": "/stream/([^/]+)/([^/]+)/([^/]+)/([^/]+)\\.json",
      "dest": "/api/stream.js?type=$1&id=$2&season=$3&episode=$4"
    }
  ],
  "functions": {
    "api/stream.js": {
      "maxDuration": 60
    }
  }
}
